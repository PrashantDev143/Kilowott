# CatalogIQ Environment Configuration
# Copy this file to .env or apps/api/.env

PORT=4001
WEB_PORT=5173
MOCK_WOO_PORT=5050

# Store Configuration (mock or live)
STORE_MODE=mock
WOO_STORE_URL=https://catlogue.local
WOO_CONSUMER_KEY=ck_your_woocommerce_consumer_key_here
WOO_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret_here
WOO_WEBHOOK_SECRET=your_webhook_secret_here
# Path to Local by Flywheel root SSL certificate (maintains full TLS verification)
NODE_EXTRA_CA_CERTS=certs/catlogue.local.crt

# AI Provider Configuration (gemini or offline)
AI_PROVIDER=offline
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Optional Postgres URL; defaults to local JSON/SQLite repository)
DATABASE_URL=

# Security & Sessions
SESSION_SECRET=catalogiq_super_secret_session_key_32chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_PASSWORD_HASH=pbkdf2$10000$mock$mockhash
